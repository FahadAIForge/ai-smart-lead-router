    {
      "parameters": {
        "jsCode": "const input = $json.body || $json;\n\nconst name = input.name || '';\nconst email = input.email || '';\nconst message = input.message || '';\nconst budget = input.budget;\n\nlet score = 0;\nif (budget) score += 30;\n\nconst msg = String(message).toLowerCase();\nif (msg.includes('urgent') || msg.includes('asap') || msg.includes('today') || msg.includes('need now')) {\n  score += 40;\n}\n\nif (String(message).length > 20) score += 15;\nif (email) score += 15;\n\nif (score > 100) score = 100;\n\nconst priority = score >= 70 ? 'HOT' : 'STANDARD';\n\nconst reply = priority === 'HOT'\n  ? `Hi ${name || 'there'}, thanks for reaching out! This sounds urgent - we will call you back within 15 minutes.`\n  : `Hi ${name || 'there'}, thanks for your message! We will get back to you with a reply today.`;\n\nreturn [{ json: { ...input, score, priority, reply } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        64
      ],
      "id": "be9f49d1-87c5-4ebc-8c09-9c9e3fb5815e",
